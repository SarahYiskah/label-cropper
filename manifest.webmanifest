{
  "name": "Label Cropper",
  "short_name": "Labels",
  "description": "Crop return-label PDFs to your thermal label size and print.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f5f3",
  "theme_color": "#111111",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": ["application/pdf", ".pdf", "image/*", ".png", ".jpg", ".jpeg", ".heic"] }] }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"], "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"], "image/heic": [".heic"], "image/webp": [".webp"] } }
  ]
}
